# 忽略所有 appsettings 文件（开发/生产/测试环境配置）
appsettings.json
appsettings.Development.json
appsettings.*.json

# 忽略用户机密文件（User Secrets 生成的 secrets.json 不会提交，但保险起见）
secrets.json

# 忽略其他常见配置文件和临时文件
*.user
*.suo
*.userprefs
*.cache
bin/
obj/
.vs/
# 允许提交无密钥的示例配置
!appsettings.*.example.json
!appsettings.example.json
