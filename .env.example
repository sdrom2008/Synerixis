# Synerixis local / docker-compose example
# cp .env.example .env  （.env 已 gitignore，勿提交真实密钥）

# ---------- Database ----------
MYSQL_ROOT_PASSWORD=root_dev
MYSQL_DATABASE=synerixis
MYSQL_USER=synerixis
MYSQL_PASSWORD=synerixis_dev
MYSQL_PORT=3306

# ---------- Redis（可选；compose --profile redis）----------
REDIS_PORT=6379
# 启用 Redis 限流时填写，例如：redis:6379
REDIS_CONNECTION=
WEBHOOK_RATE_LIMIT=120
WEBHOOK_RATE_LIMIT_STORE=Memory

# ---------- API / JWT ----------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
JWT_KEY=REPLACE_WITH_LOCAL_DEV_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=Synerixis.Dev
JWT_AUDIENCE=Synerixis.Client
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080

# ---------- Shopee ----------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=
SHOPEE_REDIRECT_URI=http://localhost:5000/api/oauth/shopee/callback
SHOPEE_ENDPOINT=https://partner.test-stable.shopeemobile.com
SHOPEE_REGION=SG

# ---------- Ai / Llm ----------
# OpenAI-compatible BaseUrl（可选；Admin 控制台也可配）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本地 Ollama: LLM_BASE_URL=http://127.0.0.1:11434/v1
# 空 Key 可演示：入站生成「未配置 AI·规则草稿」；人审发送 + SIM mock 仍闭环。
# 亦可在 merchant-web「AI 设置」填本店 Key（写入 SellerConfig.LlmApiKey）。
LLM_PROVIDER=Aliyun
LLM_API_KEY=
LLM_MODEL=qwen-plus
TONGYI_API_KEY=
DASHSCOPE_API_KEY=
AI_PRICE_PER_1K_INPUT=0.0004
AI_PRICE_PER_1K_OUTPUT=0.0012

# ---------- Frontends ----------
# MerchantWebBaseUrl：OAuth 绑店回跳前端基址；compose merchant-web 默认 8080
MERCHANT_WEB_BASE_URL=http://localhost:8080
MERCHANT_WEB_PORT=8080
